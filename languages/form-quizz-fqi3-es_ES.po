#: includes/FQI3_Blocks.php:281
msgid "Form Quizz FQI3"
msgstr "Form Quizz FQI3"

#. Description of the plugin
#: form-quizz-fqi3.php
msgid "A plugin to create and manage free quizzes with premium features."
msgstr ""
"Un plugin para crear y gestionar cuestionarios gratuitos con características "
"premium."

#. Author of the plugin
#: form-quizz-fqi3.php
msgid "Jonathan Webpixelia"
msgstr "Jonathan Webpixelia"

#. Author URI of the plugin
#: form-quizz-fqi3.php
msgid "https://webpixelia.com"
msgstr "https://webpixelia.com"

