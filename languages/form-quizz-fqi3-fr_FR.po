#: includes/FQI3_Blocks.php:261
msgid "Form Quizz FQI3"
msgstr "Form Quizz FQI3"

#. Description of the plugin
#: form-quizz-fqi3.php
msgid "A plugin to create and manage free quizzes with premium features."
msgstr ""
"Un plugin pour créer et gérer des quiz gratuits avec des fonctionnalités "
"premium."

#. Author of the plugin
#: form-quizz-fqi3.php
msgid "Jonathan Webpixelia"
msgstr "Jonathan Webpixelia"

#. Author URI of the plugin
#: form-quizz-fqi3.php
msgid "https://webpixelia.com"
msgstr "https://webpixelia.com"

#: form-quizz-fqi3.php:50
msgid "This plugin is not listed in the WordPress.org directory."
msgstr "Ce plugin n'est pas répertorié dans le répertoire WordPress.org."

