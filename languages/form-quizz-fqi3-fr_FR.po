msgid "The total number of correct answers provided by the user."
msgstr "Le nombre total de réponses correctes fournies par l’utilisateur."

#: includes/admin/class-developper.php:154
msgid "The percentage of correct answers."
msgstr "Le pourcentage de réponses correctes."

