#. Plugin Name of the plugin
#: form-quizz-fqi3.php form-quizz-fqi3.php:143
#: includes/fqi3-config-functions.php:152
msgid "Form Quizz FQI3"
msgstr "Form Quizz FQI3"

#. Description of the plugin
#: form-quizz-fqi3.php
msgid "A plugin to create and manage free quizzes with premium features."
msgstr ""
"Un plugin pour créer et gérer des quiz gratuits avec des fonctionnalités "
"premium."

#. Author of the plugin
#: form-quizz-fqi3.php
msgid "Jonathan Webpixelia"
msgstr "Jonathan Webpixelia"

#. Author URI of the plugin
#: form-quizz-fqi3.php
msgid "https://webpixelia.com"
msgstr "https://webpixelia.com"

#. translators: 1: Current PHP version 2: Required PHP version
#: form-quizz-fqi3.php:197
#, php-format
msgid ""
"Form Quizz FQI3 requires PHP version %2$s or higher. Your current version is "
"%1$s."
msgstr ""
"Le formulaire Quizz FQI3 nécessite la version PHP %2$s ou supérieure. Votre "
"version actuelle est %1$s."

