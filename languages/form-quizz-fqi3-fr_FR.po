#. Translators: %s is the limit number of quiz per day
#: form-quizz-fqi3.php:646
#, php-format
msgid ""
"You have reached the limit of %s quizzes per day as a free logged in user."
msgstr ""
"Vous avez atteint la limite de %s quiz par jour en tant qu’utilisateur "
"connecté gratuitement."

#. Translators: %1$s is the number of correct answer if singular, %2$s is the total number of questions, %3$s is the percentage of correct answers, %4$s is the finished level
#: form-quizz-fqi3.php:648
#, php-format
msgid "You have %1$s correct answer on %2$s. (%3$s%) for the %4$s level"
msgstr "Vous avez %1$s réponse correcte sur %2$s. (%3$s%) pour le niveau %4$s"

#. Translators: %1$s is the number of correct answers if plural, %2$s is the total number of questions, %3$s is the percentage of correct answers, %4$s is the finished level
#: form-quizz-fqi3.php:650
#, php-format
msgid "You have %1$s correct answers on %2$s. (%3$s%) for the %4$s level"
msgstr ""
"Vous avez %1$s réponses correctes sur %2$s. (%3$s%) pour le niveau %4$s"

#: form-quizz-fqi3.php:651
msgid "Select an answer before moving on to the next question."
msgstr "Sélectionne une réponse avant de passer à la question suivante."

